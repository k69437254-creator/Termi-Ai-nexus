+    if (g_model == nullptr || g_context == nullptr ||
+        g_sampler == nullptr || !g_chat_templates) {
+        jclass error_class = env->FindClass("java/lang/IllegalStateException");
+        if (error_class != nullptr) {
+            env->ThrowNew(error_class,
+                "Cannot reset an uninitialized native conversation");
+        }
+        return;
+    }
+
+    reset_long_term_states(true);
+    reset_short_term_states();
+    common_sampler_reset(g_sampler);
+
+    LOGi("%s: Native conversation reset completed", __func__);
+}
